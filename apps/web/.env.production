# Loaded only by `vite build`, and it takes precedence over .env.local.
#
# Without this, the localhost API base used for split dev (vite on 5173 talking
# to wrangler on 8787) would be compiled into the deployed bundle. In production
# the Worker serves this app and the API from the same origin, so the base must
# be empty.
VITE_API_BASE_URL=
VITE_USE_MOCKS=false
