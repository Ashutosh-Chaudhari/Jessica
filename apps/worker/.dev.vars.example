# Copy to apps/worker/.dev.vars for `npm run dev:worker`.
# The same three values you will later set with `wrangler secret put` (spec section 52).
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Lets the vite dev server on :5173 call this Worker. Local only.
ALLOWED_ORIGIN=http://localhost:5173
