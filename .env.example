# ---------------------------------------------------------------------------
# Jessica environment configuration
#
# Two separate places actually read configuration:
#   apps/web            -> .env / .env.local in apps/web (VITE_* only)
#   apps/worker         -> [vars] in wrangler.toml + `wrangler secret put`
#                          (or apps/worker/.dev.vars for `wrangler dev`)
#
# NEVER expose GEMINI_API_KEY, GROQ_API_KEY or SUPABASE_SERVICE_ROLE_KEY in the
# frontend bundle (spec section 52). Anything prefixed VITE_ ships to browsers.
# ---------------------------------------------------------------------------

# --- Frontend (apps/web) - safe for the browser ---
# true  = run entirely on localStorage mocks; no accounts, no keys, no backend.
# false = talk to Supabase Auth + the Worker API.
VITE_USE_MOCKS=true

# Empty means "same origin", which is how the deployed Worker serves the app.
# Set it to http://localhost:8787 when running `vite dev` against `wrangler dev`.
VITE_API_BASE_URL=

# The anon key is public by design; Row Level Security is what protects data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Worker: non-secret, set in apps/worker/wrangler.toml [vars] ---
SUPABASE_URL=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EVAL_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_THINKING_LEVEL=low
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_CHAT_MODEL=qwen/qwen3.8-27b
AI_TEXT_PROVIDER=groq
SIMILARITY_THRESHOLD=0.91
ALLOWED_ORIGIN=http://localhost:5173

# --- Worker secrets: `wrangler secret put`, or apps/worker/.dev.vars ---
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
